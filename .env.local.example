# Copy this file to .env.local and fill in real values.

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# MongoDB connection string (e.g. from MongoDB Atlas).
# If mongodb+srv:// fails with a DNS "querySrv ECONNREFUSED" error (some
# networks/DNS resolvers block SRV lookups), use Atlas's non-SRV "standard
# connection string" instead (found in Atlas under Connect > Drivers >
# "I don't have a DNS SRV" or by resolving the SRV/TXT records manually) —
# it lists each shard host directly and skips the SRV lookup entirely.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=image-generation

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
