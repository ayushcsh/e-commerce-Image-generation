# Copy this file to .env.local and fill in real values.

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# MongoDB connection string (e.g. from MongoDB Atlas).
# If mongodb+srv:// fails with a DNS "querySrv ECONNREFUSED" error (some
# networks/DNS resolvers block SRV lookups), use Atlas's non-SRV "standard
# connection string" instead (found in Atlas under Connect > Drivers >
# "I don't have a DNS SRV" or by resolving the SRV/TXT records manually) —
# it lists each shard host directly and skips the SRV lookup entirely.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=image-generation

# fal.ai API key from https://fal.ai/dashboard/keys
FAL_KEY=
# Any fal.ai image-to-image / multi-image-edit model endpoint ID.
# Defaults to fal-ai/nano-banana/edit if unset.
FAL_IMAGE_MODEL=fal-ai/nano-banana/edit

# Cloudflare R2 — S3-compatible object storage for generated images
# Get credentials from: Cloudflare Dashboard > R2 > Manage R2 API Tokens
# The account ID is on the right panel of the R2 overview page
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=generated-images
R2_PUBLIC_URL=  # Optional: custom domain bound to the R2 bucket, e.g. https://images.yourdomain.com

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Razorpay - https://dashboard.razorpay.com/app/keys (use test-mode keys while developing)
RAZORPAY_KEY_ID=rzp_test_TKQEJvBIh4RPgb
RAZORPAY_KEY_SECRET=kKBE9B6ETeSeayK81sXpwrBC
# Webhook endpoint: /api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# Resend — https://resend.com/api-keys (emails the payment receipt/bill after a purchase)
RESEND_API_KEY=
# "onboarding@resend.dev" works immediately with no domain setup; switch to your
# own verified domain's address once you've added one in the Resend dashboard.
RESEND_FROM_EMAIL=VendorFlow <onboarding@resend.dev>

# Admin panel access — comma-separated list of admin Google account emails.
# Only these emails can access /admin/*
ADMIN_EMAILS=ayushkumar.nov.2005@gmail.com

# Mistral AI — https://console.mistral.ai/api-keys (powers the floating site assistant)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
